{
  "name": "place-index",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Indice personale di posti su mappa: marker per categoria con emoji",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"vite\"",
    "dev:api": "tsx watch --tsconfig server/tsconfig.json server/src/index.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "typecheck": "npm run typecheck:web && npm run typecheck:api",
    "start": "node server/dist/index.js",
    "typecheck:web": "tsc -p tsconfig.json --noEmit",
    "typecheck:api": "tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.6.2",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.2",
    "emoji-picker-element": "^1.22.8",
    "emoji-picker-element-data": "^1.8.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide": "^1.47.0",
    "qrcode-generator": "^2.0.4",
    "svelte": "^5.57.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
